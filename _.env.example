# ===== Telegram (required) =====
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
# Comma separated Telegram user IDs allowed to use the bot
OWNER_IDS=123456789,987654321

# ===== Google Drive (rclone) =====
# One line JSON from: rclone authorize "drive"
GDRIVE_TOKEN={"access_token":"ya29.xxx","token_type":"Bearer","refresh_token":"1//xxx","expiry":"2026-01-01T00:00:00.000000000+00:00"}
# Optional: your own OAuth client (recommended, see guide)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Optional: upload into a specific Drive folder ID / Shared Drive ID
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_TEAM_DRIVE_ID=
# Optional alternative to GDRIVE_TOKEN: base64 of service-account JSON (needs a Shared Drive)
GDRIVE_SA_B64=
GDRIVE_FOLDER=TG-Hub

# ===== MEGA (no 2FA) =====
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your-mega-password
MEGA_FOLDER=TG-Hub
# Use your MEGA login for megadl (higher download quota). true/false
MEGA_LOGIN_FOR_DOWNLOAD=false

# ===== TeraBox (unofficial) =====
# Value of the "ndus" cookie (or the full cookie string)
TERABOX_COOKIE=ndus_cookie_value_here
TERABOX_FOLDER=TG-Hub

# ===== Runtime =====
PORT=8080
# Render sets RENDER_EXTERNAL_URL automatically; set APP_URL only on other hosts
APP_URL=
PING_INTERVAL=600
WORKERS=1
MAX_RETRIES=1
TMP_DIR=/tmp/hub
DB_PATH=/tmp/hub-db/jobs.db
